Type = 卡顿类型

ChainLightning = 连锁闪电（召唤）
Cyclone = 旋风斩（DK,MG）
ChainDriver = 摔绊（RF）
-->
	<SkillBackSpring>
	<!--后推-->
        <Skill IDSkill="215" Rate="1" Type="1"/>     <!--连锁闪电 召唤-->
        <Skill IDSkill="237" Rate="1" Type="1"/>     <!--闪电风暴 MG-->
		<Skill IDSkill="262" Rate="50" Type="1"/>    <!--摔绊 RF-->
		<Skill IDSkill="22"  Rate="1" Type="1"/>   <!--增强旋风斩 DK-->

	</SkillBackSpring>

	<!--眩晕-->
