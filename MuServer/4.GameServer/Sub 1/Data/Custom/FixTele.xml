		<Skill IDSkill="61" Rate="1" Delay="2"/>     <!--火舞长矛 DL-->
		<Skill IDSkill="43" Rate="1" Delay="2"/>     <!--风刺 DK-->

	</SkillChoang>

	<!--冰冻-->
