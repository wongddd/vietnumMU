<!--Test
	注意: 所需物品需放在角色背包中！
	
	数量 = XX (最低 1)
	IndexItem = Item
	等级 = -1 则不检查
	卓越属性1 = -1 则不检查
-->
<ResetTableVIP Enable="1" Notice="3"> 
	<!--TypeReset
		; 0 = 保留点数不增加 PointReset
		; 1 = 按表重置已加点数 +PointReset*重置次数
		; 2 = 按表保留已加点数 +PointReset
	-->
	<Reset MinReset="1"	MaxReset="400" > <!-- Moc Reset-->
		<LevelReset Level_AL0="250"   Level_AL1="250"   Level_AL2="250"   Level_AL3="250"/> <!--- Level Yeu Cau Khi Reset THeo Type VIP-->
		<PointReset Point_AL0="300"	  Point_AL1="300"	    Point_AL2="300"	  Point_AL3="300"/> <!--- 按重置里程碑获得点数-->
		<NguyenLieu Zen="1000000" WC="5000" WP ="0" GP="0" CheckCode="0" > <!--Item Nguyen Lieu Toi da 5 Item-->
			 <!--<Item SL="0"  IndexItem="0"  Level="0"  ExlOp="0" /> <!--Ngoc Hon Nguyen-->
			<!--Item SL="0"  IndexItem="0"  Level="0"  ExlOp="0" /> <!--Thien Tu kiem Level 5 Exl 3-->
		</NguyenLieu>	
	</Reset>
	
		
</ResetTableVIP>
