	<Message Index="0" Text="[Reset]你没有足够的%d(%s)来重置" />
	<Message Index="1" Text="[Reset]需要x%d(%s)来执行重置！" />
	<Message Index="2" Text="你需要使用重置码来进行第%d次重置！" />
    <Message Index="3" Text="角色 [%s] 第%d次普通重置成功！" />
</MessageInfo>	


<!--Test
	注意: 所需物品需放在角色背包中！
	
	数量 = XX (最低 1)
	IndexItem = Item
	等级 = -1 则不检查
	卓越属性1 = -1 则不检查
-->
<ResetTable Enable="1" Notice="3"> 
	<!--CommandResetType
		; 0 = 保留点数不增加 PointReset
		; 1 = 按表重置已加点数 +PointReset*重置次数
		; 2 = 按表保留已加点数 +PointReset
	-->
	<Reset MinReset="1"	MaxReset="400" > <!-- Moc Reset-->
		<LevelReset Level_AL0="300"   Level_AL1="300"   Level_AL2="300"   Level_AL3="300"/> <!--- Level Yeu Cau Khi Reset THeo Type VIP-->
		<PointReset Point_AL0="300"	  Point_AL1="300"    Point_AL2="300"	  Point_AL3="300"/> <!--- 按重置里程碑获得点数-->
		<NguyenLieu Zen="500000" WC="0" WP ="0" GP="0"> <!--Item Nguyen Lieu Toi da 5 Item-->
			<!--<<Item SL="0"  IndexItem="0"  Level="0"  ExlOp="-0" /> <!--Thien Tu kiem Level 0 Exl 0-->
		</NguyenLieu>		
	</Reset>
	

</ResetTable>
